# Copy to .env for local development. NEVER commit a real .env file.
# On Railway, set these in the service's Variables tab instead.

# --- Required -------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# --- Models (change if your key does not have access to these) ------------
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Optional -------------------------------------------------------------
# Default n8n webhook. Users can still override it on the Settings page.
N8N_WEBHOOK_URL=

# Where generated images are written. Railway's filesystem is ephemeral:
# attach a Volume and point this at its mount path to keep images across deploys.
MEDIA_DIR=/tmp/smmp-media

# Comma-separated origins, or * for any.
ALLOWED_ORIGINS=*

REQUEST_TIMEOUT=120
LOG_LEVEL=INFO
